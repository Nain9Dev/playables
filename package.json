{
  "name": "playables",
  "version": "1.0.0",
  "description": "A portfolio of single-file HTML5 playable ads, each verified against ad-network specs before it ships.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite games/stack-tower",
    "build:games": "node scripts/build-games.ts",
    "build:site": "node scripts/build-site.ts",
    "build": "npm run build:games && npm run build:site",
    "preview": "node scripts/serve.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nain9Dev/playables.git"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.1"
  }
}
